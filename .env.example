# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# The port the API listens on
PORT=5000

# Where the React app runs (used by CORS)
CLIENT_ORIGIN=http://localhost:5173

# Your MongoDB Atlas connection string
MONGO_URI=

# Used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# From Google Cloud Console > APIs & Services > Credentials. Must match
# the client ID the frontend uses (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Optional services
# Brevo: the sender email must be verified in Brevo > Senders, Domains & Dedicated IPs
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=WorkNest
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
